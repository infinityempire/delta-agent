FROM python:3.12-slim

WORKDIR /workspace

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    chromium \
    chromium-driver \
    nodejs \
    npm \
    vim \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN pip install --upgrade pip setuptools wheel

# Install development tools
RUN pip install \
    debugpy \
    pytest \
    pytest-asyncio \
    black \
    flake8 \
    mypy

CMD ["/bin/bash"]
