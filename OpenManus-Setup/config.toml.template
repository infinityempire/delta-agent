# OpenManus Configuration Template
# Copy this file to config/config.toml and customize for your setup

# ============================================
# GLOBAL LLM CONFIGURATION (Required)
# ============================================

[llm]
model = "claude-3-7-sonnet-20250219"       # LLM model to use
base_url = "https://api.anthropic.com/v1/" # API endpoint URL
api_key = "YOUR_API_KEY"                   # Replace with your actual API key
max_tokens = 8192                          # Maximum tokens in response
temperature = 0.0                          # Controls randomness (0.0 = deterministic)

# ============================================
# LLM VISION CONFIGURATION (Optional)
# ============================================

[llm.vision]
model = "claude-3-7-sonnet-20250219"
base_url = "https://api.anthropic.com/v1/"
api_key = "YOUR_API_KEY"
max_tokens = 8192
temperature = 0.0

