# ============================================
# BROWSER CONFIGURATION (Optional)
# ============================================

# [browser]
# Whether to run browser in headless mode
# headless = false
# Disable browser security features
# disable_security = true
# Extra arguments to pass to the browser
# extra_chromium_args = []
# Path to Chrome instance
# chrome_instance_path = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# Connect to browser via WebSocket
# wss_url = ""
# Connect to browser via CDP
# cdp_url = ""

# [browser.proxy]
# server = "http://proxy-server:port"
# username = "proxy-username"
# password = "proxy-password"

# ============================================
# SEARCH CONFIGURATION (Optional)
# ============================================

# [search]
# Search engine: "Google", "Baidu", "DuckDuckGo", "Bing"
# engine = "Google"
# Fallback engines in order
# fallback_engines = ["DuckDuckGo", "Baidu", "Bing"]
# Retry delay in seconds
# retry_delay = 60
# Maximum retries
# max_retries = 3
# Language code: "en", "zh", etc.
# lang = "en"
# Country code: "us", "cn", etc.
# country = "us"

# ============================================
# SANDBOX CONFIGURATION (Optional)
# ============================================

# [sandbox]
# use_sandbox = false
# image = "python:3.12-slim"
# work_dir = "/workspace"
# memory_limit = "1g"
# cpu_limit = 2.0
# timeout = 300
# network_enabled = true

# ============================================
# DAYTONA SANDBOX CONFIGURATION (Optional)
# ============================================

# [daytona]
# daytona_api_key = ""
# daytona_server_url = "https://app.daytona.io/api"
# daytona_target = "us"  # "us" or "eu"
# sandbox_image_name = "whitezxj/sandbox:0.1.0"
# sandbox_entrypoint = "/usr/bin/supervisord -n -c /etc/supervisor/conf.d/supervisord.conf"
# VNC_password = "123456"

# ============================================
# MCP (Model Context Protocol) Configuration
# ============================================

[mcp]
server_reference = "app.mcp.server"

