# Delta Agent - Social Media Distribution Configuration
# Copy this file to .env and fill in your credentials

# ═══════════════════════════════════════════════════════════════
# TELEGRAM (Bot API - Fully Public)
# Get your bot token from @BotFather on Telegram
# ═══════════════════════════════════════════════════════════════
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated chat IDs to post to (channels, groups, or your personal chat ID)
# Get your chat ID by messaging @userinfobot or @getidsbot
TELEGRAM_CHAT_IDS=-1001234567890,123456789

# ═══════════════════════════════════════════════════════════════
# REDDIT (Script/Personal Use App)
# Create at: https://www.reddit.com/prefs/apps
# Choose "script" type
# ═══════════════════════════════════════════════════════════════
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# ═══════════════════════════════════════════════════════════════
# BLUESKY (AT Protocol)
# Use your handle (e.g., @username.bsky.social)
# Create an app password at: https://bsky.app/settings/app-passwords
# ═══════════════════════════════════════════════════════════════
BLUESKY_HANDLE=your.bsky.social
BLUESKY_PASSWORD=your_app_password

# ═══════════════════════════════════════════════════════════════
# MASTODON (Any Instance)
# Get your token from your instance's settings > Development > New Application
# Default instance is mastodon.social
# ═══════════════════════════════════════════════════════════════
MASTODON_INSTANCE=mastodon.social
MASTODON_TOKEN=your_mastodon_access_token

# ═══════════════════════════════════════════════════════════════
# EXISTING DELTA AGENT CONFIG (Keep these from before)
# ═══════════════════════════════════════════════════════════════
GEMINI_API_KEY=your_gemini_api_key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_TO=recipient@example.com
SCRAPER_API_KEY=your_scraperapi_key
SCRAPINGBEE_API_KEY=your_scrapingbee_key
