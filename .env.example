# Delta Agent - DECENTRALIZED Social Media Distribution
# Copy to .env and fill credentials for broadcasting to open networks

# ═══════════════════════════════════════════════════════════════
# 🐘 MASTODON (Federated - ActivityPub) - PUBLIC API!
# Instances: mastodon.social, fosstodon.org, hachyderm.io, infosec.exchange
# Get token: instance/settings/development → New Application
# ═══════════════════════════════════════════════════════════════
MASTODON_INSTANCES=mastodon.social,fosstodon.org,hachyderm.io,infosec.exchange
MASTODON_TOKEN=your_mastodon_access_token

# ═══════════════════════════════════════════════════════════════
# 🌀 BLUESKY (AT Protocol) - PUBLIC API!
# Create app password: bsky.app/settings/app-passwords
# ═══════════════════════════════════════════════════════════════
BLUESKY_HANDLE=your.bsky.social
BLUESKY_PASSWORD=your_bluesky_app_password

# ═══════════════════════════════════════════════════════════════
# ⚡ NOSTR (Decentralized - Keys Based) - PUBLIC!
# Generate keys: any NIP-26 compatible tool
# Relays: wss://relay.damus.io, wss://nos.lol, wss://relay.nostr.band
# ═══════════════════════════════════════════════════════════════
NOSTR_PRIVATE_KEY=your_nsec_private_key_hex
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band

# ═══════════════════════════════════════════════════════════════
# 🌉 THREADS (Meta - ActivityPub) - PUBLIC!
# Uses Instagram Graph API token
# Get from: Meta Developer Portal → Threads API
# ═══════════════════════════════════════════════════════════════
THREADS_TOKEN=your_instagram_api_token
THREADS_USER_ID=your_threads_user_id

# ═══════════════════════════════════════════════════════════════
# 🌉 FARCASTER (Web3 Social) - REQUIRES APPROVAL
# Sign up: warpcast.com → Developers → API Access
# Limited availability - check warpcast.com/developers
# ═══════════════════════════════════════════════════════════════
FARCASTER_SIGNER=your_farcaster_signer_token

# ═══════════════════════════════════════════════════════════════
# 🦎 LEMMY (Reddit Alternative - ActivityPub) - PUBLIC API!
# Instances: lemmy.ml, beehaw.org, sopranica.net, programming.dev
# Get token: instance.com/settings → API → New Token
# ═══════════════════════════════════════════════════════════════
LEMMY_INSTANCES=lemmy.ml,beehaw.org
LEMMY_TOKEN=your_lemmy_access_token

# ═══════════════════════════════════════════════════════════════
# 📸 PIXELFED (Instagram Alternative - ActivityPub) - PUBLIC!
# Instance: pixelfed.social or any federated instance
# Get token: instance/settings → Developer → New Token
# ═══════════════════════════════════════════════════════════════
PIXELFED_INSTANCE=pixelfed.social
PIXELFED_TOKEN=your_pixelfed_access_token

# ═══════════════════════════════════════════════════════════════
# 📺 REDDIT (Traditional)
# Create app: reddit.com/prefs/apps → "script" type
# ═══════════════════════════════════════════════════════════════
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# ═══════════════════════════════════════════════════════════════
# 💻 DEV.TO (Developer Community) - PUBLIC API!
# Get key: dev.to/settings/extensions → API Keys
# ═══════════════════════════════════════════════════════════════
DEV_TO_API_KEY=your_devto_api_key

# ═══════════════════════════════════════════════════════════════
# 📝 HASHNODE (GraphQL API)
# Get token: hashnode.com/settings/developer
# ═══════════════════════════════════════════════════════════════
HASHNODE_TOKEN=your_hashnode_token
HASHNODE_PUBLICATION_ID=your_publication_id

# ═══════════════════════════════════════════════════════════════
# EXISTING DELTA AGENT CONFIG (Lead Generation)
# ═══════════════════════════════════════════════════════════════
GEMINI_API_KEY=your_gemini_api_key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_TO=recipient@example.com
SCRAPER_API_KEY=your_scraperapi_key
SCRAPINGBEE_API_KEY=your_scrapingbee_key
