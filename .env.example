# Delta Agent - Social Media Distribution Configuration
# Copy this file to .env and fill in your credentials

# ═══════════════════════════════════════════════════════════════
# TELEGRAM (Bot API - Fully Public)
# Get your bot token from @BotFather on Telegram
# ═══════════════════════════════════════════════════════════════
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_IDS=-1001234567890,123456789

# ═══════════════════════════════════════════════════════════════
# REDDIT (Script/Personal Use App)
# Create at: https://www.reddit.com/prefs/apps → "script" type
# ═══════════════════════════════════════════════════════════════
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# ═══════════════════════════════════════════════════════════════
# BLUESKY (AT Protocol) - Fully Public API!
# Use your handle → Create app password at: bsky.app/settings/app-passwords
# ═══════════════════════════════════════════════════════════════
BLUESKY_HANDLE=your.bsky.social
BLUESKY_PASSWORD=your_app_password

# ═══════════════════════════════════════════════════════════════
# MASTODON (Any Instance) - Fully Public API!
# Get token from: instance.com/settings/development → New Application
# ═══════════════════════════════════════════════════════════════
MASTODON_INSTANCE=mastodon.social
MASTODON_TOKEN=your_mastodon_access_token

# ═══════════════════════════════════════════════════════════════
# LEMMY (Fediverse) - Fully Public API!
# Instances: lemmy.ml, beehaw.org, sopranica.net, programming.dev
# Get token from: instance.com/settings → API → New Token
# ═══════════════════════════════════════════════════════════════
LEMMY_INSTANCES=lemmy.ml,beehaw.org
LEMMY_TOKEN=your_lemmy_token

# ═══════════════════════════════════════════════════════════════
# TUMBLR
# Create app at: https://www.tumblr.com/developers
# ═══════════════════════════════════════════════════════════════
TUMBLR_API_KEY=your_tumblr_api_key
TUMBLR_API_SECRET=your_tumblr_api_secret
TUMBLR_BLOG_NAME=your-blog.tumblr.com

# ═══════════════════════════════════════════════════════════════
# DEV.TO (Fully Public API!)
# Get API key at: dev.to/settings/extensions → API Keys
# ═══════════════════════════════════════════════════════════════
DEV_TO_API_KEY=your_devto_api_key

# ═══════════════════════════════════════════════════════════════
# HASHNODE (GraphQL API)
# Get token at: hashnode.com/settings/developer
# ═══════════════════════════════════════════════════════════════
HASHNODE_TOKEN=your_hashnode_token
HASHNODE_PUBLICATION_ID=your_publication_id

# ═══════════════════════════════════════════════════════════════
# EXISTING DELTA AGENT CONFIG
# ═══════════════════════════════════════════════════════════════
GEMINI_API_KEY=your_gemini_api_key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_TO=recipient@example.com
SCRAPER_API_KEY=your_scraperapi_key
SCRAPINGBEE_API_KEY=your_scrapingbee_key
